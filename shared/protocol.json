{
  "version": 1,
  "default_port": 8080,
  "ws_path": "/ws",
  "message_types": [
    "hello",
    "ready",
    "offer",
    "answer",
    "ice",
    "stats",
    "error",
    "bye"
  ],
  "roles": ["host", "viewer"],
  "defaults": {
    "width": 1280,
    "height": 720,
    "fps": 30,
    "max_bitrate_bps": 4000000,
    "min_bitrate_bps": 500000,
    "start_bitrate_bps": 2500000
  }
}
